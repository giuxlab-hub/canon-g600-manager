        self.add_button(maintenance, tr('Apri manuale ufficiale Canon'), lambda *_: open_link(CANON_MANUAL))
        self.add_button(maintenance, tr('Apri scanner (XSane, se presente)'), self.scan)
        notebook.append_page(maintenance, Gtk.Label(label=tr('Manutenzione')))
