def tr(message):
    return TRANSLATIONS.get(message, message) if ACTIVE_LANGUAGE == "en" else message


APP = 'Canon G600 Manager'
QUEUE = 'Canon_G600_series'
HOST = '192.168.1.107'
CANON_MANUAL = 'https://ij.manual.canon/ij/webmanual/Manual/All/G600%20series/EN/CNT/Top.html'

def command(*args, timeout=8):
    try:
        p = subprocess.run(args, text=True, capture_output=True, timeout=timeout, check=False)
        return (p.returncode, (p.stdout + p.stderr).strip())
    except (OSError, subprocess.TimeoutExpired) as exc:
        return (1, str(exc))

def open_link(url):
    subprocess.Popen(['xdg-open', url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

class Window(Gtk.Window):

    def __init__(self):
        super().__init__(title=APP)
        self.set_default_size(740, 600)
        self.set_border_width(16)
        self.set_position(Gtk.WindowPosition.CENTER)
        self._destroy_signal = self.connect('destroy', Gtk.main_quit)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add(root)
        head = Gtk.Label()
        head.set_markup("<span size='x-large' weight='bold'>Canon G600 Manager</span>\n<span foreground='#666666'>CUPS + Canon Remote UI • Debian / XFCE</span>")
        head.set_xalign(0)
        language_row = Gtk.Box(spacing=8)
        language_row.pack_start(head, True, True, 0)
        language_row.pack_start(Gtk.Label(label=tr('Language / Lingua:')), False, False, 0)
        language_select = Gtk.ComboBoxText()
        language_select.append('it', 'Italiano')
        language_select.append('en', 'English')
        language_select.set_active_id(ACTIVE_LANGUAGE)
        language_select.connect('changed', self.change_language)
        language_row.pack_start(language_select, False, False, 0)
        root.pack_start(language_row, False, False, 0)
        grid = Gtk.Grid(column_spacing=8, row_spacing=8)
        root.pack_start(grid, False, False, 0)
        grid.attach(Gtk.Label(label=tr('Stampante CUPS:')), 0, 0, 1, 1)
        self.queue_entry = Gtk.Entry(text=QUEUE)
        grid.attach(self.queue_entry, 1, 0, 1, 1)
        grid.attach(Gtk.Label(label=tr('IP o hostname:')), 0, 1, 1, 1)
        self.host_entry = Gtk.Entry(text=HOST)
        grid.attach(self.host_entry, 1, 1, 1, 1)
        self.button(grid, tr('Verifica stato'), 2, 0, self.refresh)
        self.button(grid, tr('Apri Remote UI'), 2, 1, self.remote)
        notebook = Gtk.Notebook()
        root.pack_start(notebook, True, True, 0)
        self.status_text = Gtk.TextView(editable=False, cursor_visible=False, wrap_mode=Gtk.WrapMode.WORD)
        scroll = Gtk.ScrolledWindow()
        scroll.add(self.status_text)
        notebook.append_page(scroll, Gtk.Label(label=tr('Stato')))
        settings = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=15)
        self.quality = Gtk.ComboBoxText()
        for q in ('Draft', 'Normal', 'High'):
            self.quality.append_text(q)
        self.quality.set_active(1)
        row = Gtk.Box(spacing=10)
        row.pack_start(Gtk.Label(label=tr('Qualità stampa di prova:')), False, False, 0)
        row.pack_start(self.quality, False, False, 0)
        settings.pack_start(row, False, False, 0)
        self.add_button(settings, tr('Stampa pagina diagnostica A4 (conferma)'), self.print_test)
        self.add_button(settings, tr('Apri impostazioni CUPS'), lambda *_: open_link('http://localhost:631/printers/'))
        self.add_button(settings, tr('Elenca tutte le opzioni CUPS'), self.options)
        notebook.append_page(settings, Gtk.Label(label=tr('Stampa')))
        maintenance = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=15)
        txt = Gtk.Label(label=(tr('La manutenzione avviene nella Remote UI ufficiale Canon.\n')
                               + tr('Potrebbe essere richiesta la password amministratore della stampante.\n')
