    def change_language(self, widget):
        global ACTIVE_LANGUAGE
        lang = widget.get_active_id()
        if not lang or lang == ACTIVE_LANGUAGE:
            return
        ACTIVE_LANGUAGE = lang
        previous_queue = self.queue_entry.get_text()
        previous_host = self.host_entry.get_text()
        previous_quality = self.quality.get_active()
        new_window = Window()
        new_window.queue_entry.set_text(previous_queue)
        new_window.host_entry.set_text(previous_host)
        new_window.quality.set_active(previous_quality)
        if hasattr(self, 'duplex'):
            new_window.duplex.set_active(self.duplex.get_active())
        new_window.show_all()
        self.disconnect(self._destroy_signal)
        self.destroy()

    def button(self, grid, title, x, y, handler):
        b = Gtk.Button(label=title)
        b.connect('clicked', handler)
        grid.attach(b, x, y, 1, 1)

    def add_button(self, box, title, handler):
        b = Gtk.Button(label=title)
        b.connect('clicked', handler)
        box.pack_start(b, False, False, 0)

    def queue(self):
        value = self.queue_entry.get_text().strip()
        if not re.fullmatch('[A-Za-z0-9_.-]+', value):
            raise ValueError(tr('Nome coda non valido'))
        return value

    def url(self, maintenance=False):
        host = self.host_entry.get_text().strip()
        if not re.fullmatch('[A-Za-z0-9.:-]+', host) or '/' in host:
            raise ValueError(tr('Indirizzo IP o hostname non valido'))
        return 'http://' + host + ('/index.html?page=PAGE_AAP' if maintenance else '/')

    def error(self, message):
        dlg = Gtk.MessageDialog(transient_for=self, flags=0, message_type=Gtk.MessageType.ERROR, buttons=Gtk.ButtonsType.OK, text=tr('Operazione non riuscita'))
        dlg.format_secondary_text(str(message))
        dlg.run()
        dlg.destroy()

    def remote(self, *_):
        try:
            open_link(self.url())
        except Exception as exc:
            self.error(exc)

    def maintenance(self, *_):
        try:
            open_link(self.url(True))
        except Exception as exc:
            self.error(exc)

    def scan(self, *_):
        try:
            subprocess.Popen(['xsane'])
        except OSError:
            self.error(tr('XSane non installato. Installare il pacchetto xsane.'))

    def display(self, s):
        self.status_text.get_buffer().set_text(s)

    def run_async(self, work):

        def target():
            try:
                result = work()
            except Exception as exc:
                result = str(exc)
            GLib.idle_add(self.display, result)
        threading.Thread(target=target, daemon=True).start()

    def refresh(self, *_):
        try:
            q = self.queue()
        except ValueError as exc:
            self.error(exc)
            return
        self.display(tr('Lettura stato CUPS in corso…'))

        def work():
            parts = []
            for args in (('lpstat', '-p', q), ('lpstat', '-v', q), ('lpstat', '-o', q), ('lpoptions', '-p', q)):
                code, out = command(*args)
                parts.append('$ ' + ' '.join(args) + '\n' + (out or tr('(nessuna coda attiva)')) + '\n')
            try:
                url = self.url()
                with urllib.request.urlopen(url, timeout=4) as resp:
                    parts.append('Canon Remote UI: HTTP ' + str(resp.status))
            except Exception as exc:
                parts.append(tr('Canon Remote UI: non raggiungibile (') + str(exc) + ')')
            return '\n'.join(parts)
        self.run_async(work)

    def options(self, *_):
        try:
            q = self.queue()
        except ValueError as exc:
            self.error(exc)
            return
        self.run_async(lambda: command('lpoptions', '-p', q, '-l')[1])

    def print_test(self, *_):
        try:
            q = self.queue()
        except ValueError as exc:
            self.error(exc)
            return
        quality = self.quality.get_active_text()
        dlg = Gtk.MessageDialog(transient_for=self, flags=0, message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.OK_CANCEL, text=tr('Stampare una pagina di prova?'))
        dlg.format_secondary_text(tr('Coda: ') + q + tr('\nFormato: A4, carta normale\nQualità: ') + quality + tr("\nSarà consumato un foglio e dell'inchiostro."))
        accepted = dlg.run() == Gtk.ResponseType.OK
        dlg.destroy()
        if not accepted:
            return
        self.display(tr('Invio stampa in corso…'))

        def work():
            import tempfile
            with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', suffix='.txt', delete=False) as f:
                path = f.name
                f.write('CANON G600 MANAGER - PRINT QUALITY TEST\n\n')
                f.write('Quality: ' + quality + '\n')
                f.write('ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz\n')
                f.write('0123456789 ! ? + - / ( ) : ;\n')
                f.write('Fine lines and text test 1234567890\n' * 15)
            try:
                code, out = command('lp', '-d', q, '-o', 'PageSize=A4', '-o', 'MediaType=Stationery', '-o', 'cupsPrintQuality=' + quality, path, timeout=20)
                return (tr('Invio riuscito:\n') if code == 0 else tr('Errore stampa:\n')) + out
            finally:
                os.unlink(path)
        self.run_async(work)
if __name__ == '__main__':
    win = Window()
    win.show_all()
    Gtk.main()
